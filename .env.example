# =====================================================================
# Variables de Entorno para Suitech Perú (Producción & Desarrollo)
# https://suitechpe.com
# Copia este archivo como .env.local para desarrollo o configúralo en Dokploy
# =====================================================================

# 1. Servicio Receptor del Formulario de Contacto (Web3Forms)
# Clave de acceso pública de Web3Forms para enviar los correos a tu bandeja:
VITE_WEB3FORMS_ACCESS_KEY=db31b2d9-0d85-411d-bd24-bf025e06ce74
# Endpoint receptor (por defecto: https://api.web3forms.com/submit):
VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit

# 2. Google Analytics 4 (Opcional)
# Measurement ID de GA4 (ej. G-A1B2C3D4E5)
# Si no está configurado, la analítica permanece en modo silencioso sin generar errores ni rastrear cookies.
VITE_GA_MEASUREMENT_ID=

# 3. Canal de WhatsApp Oficial (Opcional)
# Número de teléfono con código de país sin espacios ni signos (ej. 51912345678)
# Si no se define, el botón de WhatsApp se oculta automáticamente para no abrir números ficticios.
VITE_WHATSAPP_NUMBER=

# 4. Redes Sociales Oficiales (Opcional)
# Solo se muestran en el sitio web una vez creados y confirmados los perfiles:
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
