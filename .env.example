# Variables de Entorno para Suitech Perú (Producción & Desarrollo)

# Google Analytics 4 (Measurement ID)
# Obtén tu ID en analytics.google.com -> Administrador -> Flujos de datos -> Flujo web
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (Token de Verificación HTML)
# Copia el token de la metaetiqueta proporcionada por Search Console
VITE_GSC_VERIFICATION_TOKEN=tu_token_aqui

# Número de WhatsApp oficial de atención (código de país sin signos, ej: 51999999999)
VITE_WHATSAPP_NUMBER=51999999999
